<!doctype html>
<title>
  <%= config.title %>
  <% if (type === 'post') { %> :: <%= birthtime_ymd(file) %><% } %>
  :: <%= subject %>
</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" href="<%= path.join(root, 'favicon.png') %>">
<link rel="alternate" type="application/rss+xml" href="<%= path.join(root, 'rss.xml') %>">
<link rel="stylesheet" href="<%= path.join(root, 'style.css') %>">
<% if (type === 'metatags') { %>
<link rel="stylesheet" href="<%= path.join(root, 'vendor/chartist/dist/chartist.css') %>">
<% } %>

<header data-root="<%= root %>">
  <h1><a href="<%= root %>"><%= config.title %></a></h1>
  <% if (config.nfts.server) { %>
  <a style="visibility: hidden" class="nbe__search" href="#"><img src="<%= path.join(root, 'fts.svg') %>" alt="Search"></a>
  <% } %>
</header>

